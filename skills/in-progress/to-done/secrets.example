# Copy to `.to-done/secrets` in the repo you are running against, fill in one
# value per group, and `chmod 600` it. This file is the only place to-done
# reads credentials from. Keep it gitignored.

# Fine-grained PAT, this repo only: Issues R/W, Pull requests R/W,
# Contents R/W, Metadata R. Nothing else, and nothing cross-repo.
GH_TOKEN=

# Claude, pick one. `claude setup-token` mints the subscription token; the API
# key bills per token, and a long run is a lot of tokens. Only the one you
# set reaches the container, so an expired token fails the phase instead of
# quietly falling back to metered billing.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Codex, used only by the review phase; pick one. On a personal ChatGPT plan
# this is a one-line copy of your auth.json: `jq -c . ~/.codex/auth.json`. It
# carries the refresh token, so codex renews itself mid-run. Set both and the
# API key is the fallback if the first is refused.
CODEX_AUTH_JSON=
# OPENAI_API_KEY=
